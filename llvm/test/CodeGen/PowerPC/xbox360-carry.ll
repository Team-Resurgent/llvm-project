; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=powerpc64-unknown-xbox360 -verify-machineinstrs < %s | FileCheck %s

; Xbox 360 titles run in the 32-bit computation mode: XER[CA] is the carry out
; of the low 32 bits, even for the 64-bit add/subtract instructions. So no
; 64-bit value's carry or borrow may come from addc/adde/subfc/subfe/addic/
; subfic/addze/addme/subfze/subfme; it is computed with compares. (sradi sets
; CA from the full 64-bit operand, so sradi + addze stays.)

define i128 @add128(i128 %a, i128 %b) {
; CHECK-LABEL: add128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mr 7, 4
; CHECK-NEXT:    add 4, 4, 6
; CHECK-NEXT:    cmpld 4, 7
; CHECK-NEXT:    li 6, 1
; CHECK-NEXT:    bc 12, 0, .LBB0_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    li 6, 0
; CHECK-NEXT:  .LBB0_2:
; CHECK-NEXT:    add 3, 3, 5
; CHECK-NEXT:    add 3, 3, 6
; CHECK-NEXT:    blr
  %r = add i128 %a, %b
  ret i128 %r
}

define i128 @sub128(i128 %a, i128 %b) {
; CHECK-LABEL: sub128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    cmpld 4, 6
; CHECK-NEXT:    li 7, 1
; CHECK-NEXT:    bc 12, 0, .LBB1_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    li 7, 0
; CHECK-NEXT:  .LBB1_2:
; CHECK-NEXT:    sub 3, 3, 5
; CHECK-NEXT:    sub 4, 4, 6
; CHECK-NEXT:    sub 3, 3, 7
; CHECK-NEXT:    blr
  %r = sub i128 %a, %b
  ret i128 %r
}

