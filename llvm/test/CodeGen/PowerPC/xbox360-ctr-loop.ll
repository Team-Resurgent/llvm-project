; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=powerpc64-unknown-xbox360 -verify-machineinstrs < %s | FileCheck %s

; Xbox 360 titles run in the 32-bit computation mode, where bdnz tests only the
; low 32 bits of CTR. A loop whose trip count may not fit in 32 bits keeps its
; compare-and-branch; a 32-bit trip count still becomes mtctr/bdnz.

define void @count64(ptr %p, i64 %n) {
; CHECK-LABEL: count64:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li 5, 0
; CHECK-NEXT:    addi 3, 3, -1
; CHECK-NEXT:  .LBB0_1: # %loop
; CHECK-NEXT:    #
; CHECK-NEXT:    addi 4, 4, -1
; CHECK-NEXT:    clrldi 6, 3, 32
; CHECK-NEXT:    stb 5, 1(6)
; CHECK-NEXT:    cmpldi 4, 0
; CHECK-NEXT:    addi 3, 3, 1
; CHECK-NEXT:    bne 0, .LBB0_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    blr
entry:
  br label %loop
loop:
  %i = phi i64 [ 0, %entry ], [ %i1, %loop ]
  %q = getelementptr i8, ptr %p, i64 %i
  store volatile i8 0, ptr %q
  %i1 = add i64 %i, 1
  %c = icmp ne i64 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

define void @count32(ptr %p, i32 %n) {
; CHECK-LABEL: count32:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    cmplwi 4, 0
; CHECK-NEXT:    beqlr 0
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    mtctr 4
; CHECK-NEXT:    addi 3, 3, -1
; CHECK-NEXT:    li 4, 0
; CHECK-NEXT:  .LBB1_2: # %loop
; CHECK-NEXT:    #
; CHECK-NEXT:    clrldi 5, 3, 32
; CHECK-NEXT:    addi 3, 3, 1
; CHECK-NEXT:    stb 4, 1(5)
; CHECK-NEXT:    bdnz .LBB1_2
; CHECK-NEXT:  # %bb.3: # %exit
; CHECK-NEXT:    blr
entry:
  %z = icmp eq i32 %n, 0
  br i1 %z, label %exit, label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  %q = getelementptr i8, ptr %p, i32 %i
  store volatile i8 0, ptr %q
  %i1 = add i32 %i, 1
  %c = icmp ne i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}

; A loop with a call in it cannot use CTR, so the hardware-loop count becomes an
; ordinary counter. A 32-bit count must be tested with a 32-bit compare: the
; upper half of its register is not defined, and a 64-bit compare of it may
; never reach zero.
declare void @g(i32)

define void @count32_call(i32 %n) {
; CHECK-LABEL: count32_call:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    mflr 0
; CHECK-NEXT:    .cfi_def_cfa_offset 112
; CHECK-NEXT:    .cfi_offset lr, -8
; CHECK-NEXT:    .cfi_offset r29, -32
; CHECK-NEXT:    .cfi_offset r30, -24
; CHECK-NEXT:    std 29, -32(1) # 8-byte Folded Spill
; CHECK-NEXT:    std 30, -24(1) # 8-byte Folded Spill
; CHECK-NEXT:    stdu 1, -112(1)
; CHECK-NEXT:    mr 30, 3
; CHECK-NEXT:    std 0, 104(1)
; CHECK-NEXT:    cmplwi 30, 0
; CHECK-NEXT:    beq 0, .LBB2_3
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    li 29, 0
; CHECK-NEXT:  .LBB2_2: # %loop
; CHECK-NEXT:    #
; CHECK-NEXT:    clrldi 3, 29, 32
; CHECK-NEXT:    bl g
; CHECK-NEXT:    nop
; CHECK-NEXT:    addi 30, 30, -1
; CHECK-NEXT:    addi 29, 29, 1
; CHECK-NEXT:    cmplwi 30, 0
; CHECK-NEXT:    bc 12, 1, .LBB2_2
; CHECK-NEXT:  .LBB2_3: # %exit
; CHECK-NEXT:    addi 1, 1, 112
; CHECK-NEXT:    ld 0, -8(1)
; CHECK-NEXT:    mtlr 0
; CHECK-NEXT:    ld 30, -24(1) # 8-byte Folded Reload
; CHECK-NEXT:    ld 29, -32(1) # 8-byte Folded Reload
; CHECK-NEXT:    blr
entry:
  %z = icmp eq i32 %n, 0
  br i1 %z, label %exit, label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i1, %loop ]
  call void @g(i32 %i)
  %i1 = add i32 %i, 1
  %c = icmp ne i32 %i1, %n
  br i1 %c, label %loop, label %exit
exit:
  ret void
}
