; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=powerpc64-unknown-xbox360 -verify-machineinstrs < %s | FileCheck %s

; ILP32 on PPC64 (Xbox 360): a frame address is an i32, so it is materialized
; by a 32-bit ADDI whose base operand must be named r1 (GPRC), not x1 (G8RC) --
; the same register, but the machine verifier rejected the 64-bit name.

declare void @g(ptr)

define void @local_address() {
; CHECK-LABEL: local_address:
; CHECK:       # %bb.0:
; CHECK-NEXT:    mflr 0
; CHECK-NEXT:    stdu 1, -96(1)
; CHECK-NEXT:    std 0, 88(1)
; CHECK-NEXT:    .cfi_def_cfa_offset 96
; CHECK-NEXT:    .cfi_offset lr, -8
; CHECK-NEXT:    addi 3, 1, 84
; CHECK-NEXT:    clrldi 3, 3, 32
; CHECK-NEXT:    bl g
; CHECK-NEXT:    nop
; CHECK-NEXT:    addi 1, 1, 96
; CHECK-NEXT:    ld 0, -8(1)
; CHECK-NEXT:    mtlr 0
; CHECK-NEXT:    blr
  %a = alloca i32
  call void @g(ptr %a)
  ret void
}
