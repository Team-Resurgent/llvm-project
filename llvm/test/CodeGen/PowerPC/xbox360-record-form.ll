; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 6
; RUN: llc -mtriple=powerpc64-unknown-xbox360 -verify-machineinstrs < %s | FileCheck %s

; Xbox 360 titles run in the 32-bit computation mode: a record form (add.,
; and., rldicl., ...) sets CR0 from the low 32 bits of its result, so it must
; not replace a 64-bit compare with zero.

define void @add_eq0(i64 %a, i64 %b, ptr %p) {
; CHECK-LABEL: add_eq0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    add 3, 3, 4
; CHECK-NEXT:    clrldi 4, 5, 32
; CHECK-NEXT:    std 3, 0(4)
; CHECK-NEXT:    cmpldi 3, 0
; CHECK-NEXT:    bnelr 0
; CHECK-NEXT:  # %bb.1: # %zero
; CHECK-NEXT:    clrldi 3, 5, 32
; CHECK-NEXT:    li 4, 1
; CHECK-NEXT:    std 4, 0(3)
; CHECK-NEXT:    blr
  %t = add i64 %a, %b
  store i64 %t, ptr %p
  %c = icmp eq i64 %t, 0
  br i1 %c, label %zero, label %done
zero:
  store i64 1, ptr %p
  br label %done
done:
  ret void
}

define void @and_slt0(i64 %a, i64 %b, ptr %p) {
; CHECK-LABEL: and_slt0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    and 3, 3, 4
; CHECK-NEXT:    clrldi 4, 5, 32
; CHECK-NEXT:    std 3, 0(4)
; CHECK-NEXT:    cmpdi 3, -1
; CHECK-NEXT:    bgtlr 0
; CHECK-NEXT:  # %bb.1: # %neg
; CHECK-NEXT:    clrldi 3, 5, 32
; CHECK-NEXT:    li 4, 1
; CHECK-NEXT:    std 4, 0(3)
; CHECK-NEXT:    blr
  %t = and i64 %a, %b
  store i64 %t, ptr %p
  %c = icmp slt i64 %t, 0
  br i1 %c, label %neg, label %done
neg:
  store i64 1, ptr %p
  br label %done
done:
  ret void
}

define void @rot_ne0(i64 %a, ptr %p) {
; CHECK-LABEL: rot_ne0:
; CHECK:       # %bb.0:
; CHECK-NEXT:    rldicl 3, 3, 61, 3
; CHECK-NEXT:    clrldi 5, 4, 32
; CHECK-NEXT:    std 3, 0(5)
; CHECK-NEXT:    cmpldi 3, 0
; CHECK-NEXT:    beqlr 0
; CHECK-NEXT:  # %bb.1: # %nz
; CHECK-NEXT:    clrldi 3, 4, 32
; CHECK-NEXT:    li 4, 1
; CHECK-NEXT:    std 4, 0(3)
; CHECK-NEXT:    blr
  %t = lshr i64 %a, 3
  store i64 %t, ptr %p
  %c = icmp ne i64 %t, 0
  br i1 %c, label %nz, label %done
nz:
  store i64 1, ptr %p
  br label %done
done:
  ret void
}
