; Xenon's VMX does not implement the AltiVec integer multiplies (vmule*,
; vmulo*, vmladduhm, vmsum*, ...: illegal instructions on the console), which is
; how integer vector multiplies otherwise lower. They are done one element at a
; time instead. (The v16i8 multiply used to hit an assertion on this target.)

define <4 x i32> @mul_v4i32(<4 x i32> %a, <4 x i32> %b) {
; CHECK-LABEL: mul_v4i32:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi 3, 1, -32
; CHECK-NEXT:    stvx 2, 0, 3
; CHECK-NEXT:    addi 3, 1, -48
; CHECK-NEXT:    stvx 1, 0, 3
; CHECK-NEXT:    lwz 3, -20(1)
; CHECK-NEXT:    lwz 4, -36(1)
; CHECK-NEXT:    mullw 3, 4, 3
; CHECK-NEXT:    lwz 4, -40(1)
; CHECK-NEXT:    stw 3, -4(1)
; CHECK-NEXT:    lwz 3, -24(1)
; CHECK-NEXT:    mullw 3, 4, 3
; CHECK-NEXT:    lwz 4, -44(1)
; CHECK-NEXT:    stw 3, -8(1)
; CHECK-NEXT:    lwz 3, -28(1)
; CHECK-NEXT:    mullw 3, 4, 3
; CHECK-NEXT:    lwz 4, -48(1)
; CHECK-NEXT:    stw 3, -12(1)
; CHECK-NEXT:    lwz 3, -32(1)
; CHECK-NEXT:    mullw 3, 4, 3
; CHECK-NEXT:    stw 3, -16(1)
; CHECK-NEXT:    addi 3, 1, -16
; CHECK-NEXT:    lvx 2, 0, 3
; CHECK-NEXT:    blr
  %r = mul <4 x i32> %a, %b
  ret <4 x i32> %r
}

